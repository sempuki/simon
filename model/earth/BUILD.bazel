load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "atmosphere",
    hdrs = ["atmosphere.hpp"],
    copts = COPTS,
    deps = ["//core:units"],
)


cc_library(
    name = "earth",
    srcs = ["earth.cpp"],
    hdrs = ["earth.hpp"],
    copts = COPTS,
    deps = [
        "//core:math",
        "//core:units",
        "//3rd_party:eigen",
    ],
)


cc_library(
    name = "wind",
    srcs = ["wind.cpp"],
    hdrs = ["wind.hpp"],
    copts = COPTS,
    deps = [
        "//core:units",
        "//core:argument",
        "//core:math",
        "//core:random",
        "//3rd_party:eigen",
    ],
)


[cc_test(
    name = test + "_test",
    size = "small",
    srcs = [test + "_test.cpp"],
    copts = COPTS,
    deps = [
        ":" + test,
        "//core:argument",
        "//core:math",
        "@lib//base:testing",
    ],
) for test in [
    "atmosphere",
    "earth",
    "wind",
]]
