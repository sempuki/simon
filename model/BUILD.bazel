cc_library(
    name = "earth",
    hdrs = ["earth.hpp"],
    copts = COPTS,
    deps = [
        ":units",
        "@eigen",
    ],
)

cc_library(
    name = "rigid_body",
    hdrs = ["rigid_body.hpp"],
    copts = COPTS,
    deps = [
        ":kinematics",
        ":units",
        "//framework",
        "@eigen",
