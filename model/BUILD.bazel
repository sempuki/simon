    deps = [
        ":control",
        ":units",
    ],
)

cc_library(
    name = "aircraft_data",
    srcs = ["aircraft_data.cpp"],
    hdrs = ["aircraft_data.hpp"],
    copts = COPTS,
    deps = [
        ":aerodynamics",
        ":flight_control",
        ":units",
        "@lib//base:status",
    ],
