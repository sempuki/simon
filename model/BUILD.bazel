[cc_test(
    name = test + "_test",
    size = "small",
    srcs = [test + "_test.cpp"],
    copts = COPTS,
    deps = [
        ":" + test,
        "@lib//base:testing",
    ],
) for test in [
    "aerodynamics",
    "atmosphere",
    "earth",
    "control",
    "flight_path",
    "guidance",
    "lane_graph",
    "road",
    "traffic_control",
    "wind",
]]
