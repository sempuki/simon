        "//framework:vocabulary",
        "@eigen",
    ],
)

cc_library(
    name = "random",
    hdrs = ["random.hpp"],
    copts = COPTS,
)

[cc_test(
    name = test + "_test",
    size = "small",
    srcs = [test + "_test.cpp"],
    copts = COPTS,
    deps = [
        ":" + test,
        "@lib//base:testing",
    ],
) for test in [
    "aerodynamics",
    "aircraft_data",
    "atmosphere",
    "earth",
    "control",
    "flight_path",
    "guidance",
    "random",
    "wind",
]]
