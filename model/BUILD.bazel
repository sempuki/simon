load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "units",
    hdrs = ["units.hpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        "@eigen",
        "@mp-units",
    ],
)

cc_test(
    name = "units_test",
    size = "small",
    srcs = ["units_test.cpp"],
    copts = COPTS,
    deps = [
        ":units",
        "@lib//base:testing",
    ],
)

cc_library(
    name = "kinematics",
    hdrs = ["kinematics.hpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":units",
        "//framework",
        "@eigen",
        "@lib//base:core",
    ],
)

cc_library(
    name = "motion",
    hdrs = ["motion.hpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":kinematics",
        "//framework",
    ],
)

cc_test(
    name = "kinematics_test",
    size = "small",
    srcs = ["kinematics_test.cpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":kinematics",
        "@lib//base:testing",
    ],
)

cc_library(
    name = "guidance",
    hdrs = ["guidance.hpp"],
    copts = COPTS,
    deps = [
        ":kinematics",
        ":units",
    ],
)

cc_library(
    name = "atmosphere",
    hdrs = ["atmosphere.hpp"],
    copts = COPTS,
    deps = [":units"],
)

cc_library(
    name = "control",
    hdrs = ["control.hpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":units",
        "@lib//base:core",
    ],
)

cc_library(
    name = "aerodynamics",
    srcs = ["aerodynamics.cpp"],
    hdrs = ["aerodynamics.hpp"],
    copts = COPTS,
    deps = [
        ":control",
        ":units",
