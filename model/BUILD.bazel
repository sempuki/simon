    srcs = ["rigid_aircraft_test.cpp"],
    copts = COPTS,
    deps = [
        ":rigid_aircraft",
        "@lib//base:testing",
    ],
)

cc_library(
    name = "trim",
    srcs = ["trim.cpp"],
    hdrs = ["trim.hpp"],
    copts = COPTS,
    deps = [
        ":aircraft_data",
        ":atmosphere",
        ":flight_control",
        ":rigid_aircraft",
        ":rigid_body",
        ":units",
        "@eigen",
        "@lib//base:core",
        "@lib//base:status",
    ],
