load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "kinematics",
    hdrs = ["kinematics.hpp"],
    copts = COPTS,
    deps = [
        "//core:coordinates",
        "//core:units",
        "//core:vocabulary",
        "//3rd_party:eigen",
        "@lib//base:core",
    ],
)


cc_library(
    name = "motion",
    hdrs = ["motion.hpp"],
    copts = COPTS,
    deps = [
        "//core:vocabulary",
        ":kinematics",
        "//framework",
    ],
)


cc_test(
    name = "kinematics_test",
    size = "small",
    srcs = ["kinematics_test.cpp"],
    copts = COPTS,
    deps = [
        "//core:vocabulary",
        ":kinematics",
        "@lib//base:testing",
    ],
)


cc_library(
    name = "guidance",
    hdrs = ["guidance.hpp"],
    copts = COPTS,
    deps = [
        ":kinematics",
        "//core:units",
    ],
)


cc_library(
    name = "control",
    hdrs = ["control.hpp"],
    copts = COPTS,
    deps = [
        "//core:vocabulary",
        "//core:units",
        "@lib//base:core",
    ],
)


cc_library(
    name = "rigid_body",
    hdrs = ["rigid_body.hpp"],
    copts = COPTS,
    deps = [
        ":kinematics",
        "//core:time",
        "//core:units",
        "//3rd_party:eigen",
    ],
)


cc_test(
    name = "rigid_body_test",
    size = "small",
    srcs = ["rigid_body_test.cpp"],
    copts = COPTS,
    deps = [
        ":rigid_body",
        "//framework:continuous",
        "@lib//base:testing",
    ],
)


cc_library(
    name = "collision",
    srcs = ["collision.cpp"],
    hdrs = ["collision.hpp"],
    copts = COPTS,
)

[cc_test(
    name = test + "_test",
    size = "small",
    srcs = [test + "_test.cpp"],
    copts = COPTS,
    deps = [
        ":" + test,
        "@lib//base:testing",
    ],
) for test in [
    "control",
    "guidance",
]]
