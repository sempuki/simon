load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "road",
    srcs = ["road.cpp"],
    hdrs = ["road.hpp"],
    copts = COPTS,
    deps = [
        "//core:units",
        "//3rd_party:eigen",
        "@lib//base:core",
    ],
)


cc_library(
    name = "lane_graph",
    srcs = ["lane_graph.cpp"],
    hdrs = ["lane_graph.hpp"],
    copts = COPTS,
    deps = [
        ":road",
        "@lib//base:core",
    ],
)


cc_library(
    name = "walking_graph",
    srcs = ["walking_graph.cpp"],
    hdrs = ["walking_graph.hpp"],
    copts = COPTS,
    deps = [
        ":lane_graph",
        ":road",
        "//core:units",
        "@lib//base:core",
    ],
)


cc_library(
    name = "polyline",
    srcs = ["polyline.cpp"],
    hdrs = ["polyline.hpp"],
    copts = COPTS,
)


cc_library(
    name = "road_placement",
    srcs = ["road_placement.cpp"],
    hdrs = ["road_placement.hpp"],
    copts = COPTS,
    deps = [
        ":lane_graph",
        ":road",
        "//core:argument",
        "//core:units",
        "@lib//base:core",
    ],
)




[cc_test(
    name = test + "_test",
    size = "small",
    srcs = [test + "_test.cpp"],
    copts = COPTS,
    deps = [
        ":" + test,
        "@lib//base:testing",
    ],
) for test in [
    "lane_graph",
    "road",
]]
