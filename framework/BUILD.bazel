load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "framework",
    srcs = ["builder.cpp"],
    hdrs = [
        "archetype.hpp",
        "builder.hpp",
        "command.hpp",
        "entity.hpp",
        "name.hpp",
        "spatial_index.hpp",
        "step.hpp",
        "store.hpp",
        "system.hpp",
        "type_list.hpp",
        "world.hpp",
    ],
    copts = COPTS,
    deps = [
        "@lib//base:core",
        "@lib//base:status",
        "@lib//base:time",
    ],
)

[cc_test(
    name = test + "_test",
    size = "small",
    srcs = [
        test + "_test.cpp",
        "test_world.hpp",
    ],
    copts = COPTS,
    deps = [
        ":framework",
        "@lib//base:testing",
    ],
) for test in [
    "entity",
    "name",
    "spatial_index",
    "store",
    "system",
    "world",
]]

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

# Dense store against a stable-slot store; backs the store layout decision in
# documents/design.md. Run with: bazel run -c opt //framework:store_benchmark
cc_binary(
    name = "store_benchmark",
    srcs = ["store_benchmark.cpp"],
    copts = COPTS,
    deps = [":framework"],
)

# What a system pays to reach a sibling entity-component, against a handle and a
# shared dense order; see the notes at the top of the file. Run with:
# bazel run -c opt //framework:system_benchmark [-- --contend[=N]]
cc_binary(
    name = "system_benchmark",
    srcs = ["system_benchmark.cpp"],
    copts = COPTS,
    deps = [
        ":benchmark_support",
        ":framework",
    ],
)

# Store layouts under churn: dense, sorted, owning group, hybrid, generational
# and archetype segments; backs the layout decision in documents/design.md.
# Run with: bazel run -c opt //framework:churn_benchmark [-- --contend[=N]]
cc_binary(
    name = "churn_benchmark",
    srcs = ["churn_benchmark.cpp"],
    copts = COPTS,
    deps = [
        ":benchmark_support",
        ":framework",
    ],
)

cc_library(
    name = "benchmark_support",
    hdrs = ["benchmark_support.hpp"],
    copts = COPTS,
    # For benchmarks only.
    visibility = [
        "//application:__subpackages__",
        "//framework:__pkg__",
    ],
    deps = ["@lib//base:core"],
)

cc_test(
    name = "benchmark_support_test",
    size = "small",
    srcs = ["benchmark_support_test.cpp"],
    copts = COPTS,
    deps = [
        ":benchmark_support",
        "@lib//base:testing",
    ],
)
