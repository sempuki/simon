load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "format_error",
    srcs = ["format_error.cpp"],
    hdrs = ["format_error.hpp"],
    copts = COPTS,
    deps = [
        "@lib//base:status",
    ],
)

cc_library(
    name = "text",
    srcs = ["text.cpp"],
    hdrs = ["text.hpp"],
    copts = COPTS,
    deps = [
        ":format_error",
        "@lib//base:status",
    ],
)

cc_library(
    name = "xml",
    srcs = ["xml.cpp"],
    hdrs = ["xml.hpp"],
    copts = COPTS,
    deps = [
        ":format_error",
        ":text",
        "@lib//base:core",
        "@lib//base:status",
        "//3rd_party:pugixml",
    ],
)

cc_library(
    name = "aircraft_file",
    srcs = ["aircraft_file.cpp"],
    hdrs = ["aircraft_file.hpp"],
    copts = COPTS,
    deps = [
        ":format_error",
        ":text",
        "//model:aircraft_data",
        "@lib//base:core",
        "@lib//base:status",
    ],
)

cc_library(
    name = "opendrive",
    srcs = ["opendrive.cpp"],
    hdrs = ["opendrive.hpp"],
    copts = COPTS,
    deps = [
        ":format_error",
        ":text",
        ":xml",
        "//model:road",
        "@lib//base:core",
        "@lib//base:status",
        "//3rd_party:pugixml",
    ],
)

cc_library(
    name = "mjcf",
    srcs = ["mjcf.cpp"],
    hdrs = ["mjcf.hpp"],
    copts = COPTS,
    deps = [
        ":format_error",
        ":text",
        ":xml",
        "//model:articulated",
        "//model:articulated_arithmetic",
        "@lib//base:core",
        "@lib//base:status",
        "//3rd_party:pugixml",
    ],
)

cc_library(
    name = "openscenario",
    srcs = ["openscenario.cpp"],
    hdrs = ["openscenario.hpp"],
    copts = COPTS,
    deps = [
        ":format_error",
        ":text",
        ":xml",
        "//scenario:openscenario",
        "//scenario:parameter_distribution",
        "@lib//base:core",
        "@lib//base:status",
        "//3rd_party:pugixml",
    ],
)

cc_library(
    name = "tire_file",
    srcs = ["tire_file.cpp"],
    hdrs = ["tire_file.hpp"],
    copts = COPTS,
    deps = [
        ":format_error",
        ":text",
        "//model:tire",
        "@lib//base:core",
        "@lib//base:status",
    ],
)

[cc_test(
    name = test + "_test",
    size = "small",
    srcs = [test + "_test.cpp"],
    copts = COPTS,
    deps = [
        ":" + test,
        "@lib//base:testing",
    ],
) for test in [
    "aircraft_file",
    "opendrive",
    "text",
    "xml",
]]
