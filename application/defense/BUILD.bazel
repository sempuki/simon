load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "defense_library",
    srcs = ["simulation.cpp"],
    hdrs = [
        "simulation_components.hpp",
        "simulation.hpp",
        "simulation_systems.hpp",
    ],
    copts = COPTS,
    deps = [
        "//core:argument",
        "//engine:event_queue",
        "//engine:lifecycle",
        "//engine:rate_gate",
        "//framework",
        "//model:guidance",
        "//model:kinematics",
        "//core:random",
        "//core:units",
        "@lib//base:core",
    ],
)

cc_test(
    name = "defense_test",
    size = "small",
    srcs = ["defense_test.cpp"],
    copts = COPTS,
    deps = [
        "//core:argument",
        ":defense_library",
        "//engine:driver",
        "@lib//base:testing",
    ],
)

cc_binary(
    name = "defense",
    srcs = ["main.cpp"],
    copts = COPTS,
    deps = [
        "//core:argument",
        ":defense_library",
        "//engine:driver",
    ],
)

cc_binary(
    name = "viewer",
    srcs = ["viewer.cpp"],
    copts = COPTS,
    deps = [
        "//core:argument",
        ":defense_library",
        "//application:viewing",
        "//engine:driver",
        "//3rd_party:imgui",
        "//3rd_party:implot",
        "@lib//base:core",
    ],
)

cc_test(
    name = "viewer_test",
    size = "small",
    srcs = ["viewer.cpp"],
    args = ["--frames=60"],
    copts = COPTS,
    env = {"SDL_VIDEODRIVER": "dummy"},
    deps = [
        "//core:argument",
        ":defense_library",
        "//application:viewing",
        "//engine:driver",
        "//3rd_party:imgui",
        "//3rd_party:implot",
        "@lib//base:core",
    ],
)

cc_binary(
    name = "defense_benchmark",
    srcs = ["defense_benchmark.cpp"],
    copts = COPTS,
    deps = [
        "//core:argument",
        ":defense_library",
        "//framework",
        "//framework:benchmarking",
        "@lib//base:core",
    ],
)
