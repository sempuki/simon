load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "flight_library",
    srcs = ["simulation.cpp"],
    hdrs = [
        "components.hpp",
        "simulation.hpp",
        "systems.hpp",
    ],
    copts = COPTS,
    deps = [
        "//engine:lifecycle",
        "//engine:rate_gate",
        "//framework",
        "//framework:continuous",
        "//model:atmosphere",
        "//model:control",
        "//model:flight_path",
        "//model:random",
        "//model:units",
        "@lib//base:core",
    ],
)

cc_test(
    name = "flight_test",
    size = "small",
    srcs = ["flight_test.cpp"],
    copts = COPTS,
    deps = [
        ":flight_library",
        "//engine:driver",
        "@lib//base:testing",
    ],
)

# Replays JSBSim's 737 through Fly and Precise. reference/jsbsim_737.py
# regenerates the reference.
cc_test(
    name = "accuracy_test",
    size = "small",
    srcs = ["accuracy_test.cpp"],
    copts = COPTS,
    data = ["reference/jsbsim_737.csv"],
    deps = [
        ":flight_library",
        "@lib//base:testing",
    ],
)

# Checks the 737's converted aerodynamics against JSBSim's at recorded
# states. reference/jsbsim_737_aero.py regenerates the reference.
cc_test(
    name = "aero_test",
    size = "small",
    srcs = ["aero_test.cpp"],
    copts = COPTS,
    data = [
        "aircraft/737.aircraft",
        "reference/jsbsim_737_aero.csv",
    ],
    deps = [
        "//model:aerodynamics",
        "//model:aircraft_data",
        "//model:units",
        "@lib//base:testing",
    ],
)

# Flies one scenario as fast as possible and prints what it did.
cc_binary(
    name = "flight",
    srcs = ["main.cpp"],
    copts = COPTS,
    deps = [
        ":flight_library",
        "//engine:driver",
    ],
)

# Times the simulation at growing populations, system by system, for the
# single-pass model and for Runge-Kutta 4. Run with
# bazel run -c opt //application/flight:flight_benchmark
cc_binary(
    name = "flight_benchmark",
    srcs = ["flight_benchmark.cpp"],
    copts = COPTS,
    deps = [
        ":flight_library",
        "//framework",
        "//framework:benchmark_support",
        "@lib//base:core",
    ],
)
