load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "hello_library",
    srcs = ["hello.cpp"],
    hdrs = ["hello.hpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        "//framework",
        "//engine:lifecycle",
        "//model:kinematics",
        "//model:motion",
        "//model:random",
        "//model:units",
    ],
)

cc_test(
    name = "hello_test",
    size = "small",
    srcs = ["hello_test.cpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":hello_library",
        "//engine:driver",
        "@lib//base:testing",
    ],
)

cc_binary(
    name = "hello",
    srcs = ["main.cpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":hello_library",
        "//engine:driver",
    ],
)

cc_binary(
    name = "viewer",
    srcs = ["viewer.cpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":hello_library",
        "//application:viewing",
        "//engine:driver",
        "//3rd_party:imgui",
        "//3rd_party:implot",
        "@lib//base:core",
    ],
)

cc_test(
    name = "viewer_test",
    size = "small",
    srcs = ["viewer.cpp"],
    args = ["--frames=60"],
    copts = COPTS,
    env = {"SDL_VIDEODRIVER": "dummy"},
    deps = [
        "//framework:vocabulary",
        ":hello_library",
        "//application:viewing",
        "//engine:driver",
        "//3rd_party:imgui",
        "//3rd_party:implot",
        "@lib//base:core",
    ],
)
