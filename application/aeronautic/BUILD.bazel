load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "aeronautic_library",
    srcs = ["simulation.cpp"],
    hdrs = [
        "simulation_components.hpp",
        "simulation.hpp",
        "simulation_systems.hpp",
    ],
    copts = COPTS,
    deps = [
        "//model:trim",
        "//framework:vocabulary",
        "//engine:lifecycle",
        "//engine:rate_gate",
        "//framework",
        "//framework:continuous",
        "//model:atmosphere",
        "//model:control",
        "//model:aircraft_data",
        "//model:flight_path",
        "//model:random",
        "//model:rigid_aircraft",
        "//model:rigid_body",
        "//model:units",
        "@lib//base:core",
    ],
)

cc_library(
    name = "testing",
    testonly = True,
    hdrs = ["testing.hpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        "//model:rigid_body",
        "//model:units",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "aeronautic_test",
    size = "medium",
    srcs = ["aeronautic_test.cpp"],
    copts = COPTS,
    data = [
        "aircraft/737.aircraft",
        "aircraft/f16.aircraft",
    ],
    deps = [
        "//framework:vocabulary",
        ":aeronautic_library",
        "//engine:driver",
        "@lib//base:testing",
    ],
)

