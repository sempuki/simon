load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "missile_library",
    srcs = ["simulation.cpp"],
    hdrs = [
        "components.hpp",
        "simulation.hpp",
        "systems.hpp",
    ],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        "//engine:event_queue",
        "//engine:lifecycle",
        "//engine:rate_gate",
        "//framework",
        "//model:guidance",
        "//model:kinematics",
        "//model:motion",
        "//model:random",
        "//model:units",
        "@lib//base:core",
    ],
)

cc_test(
    name = "missile_test",
    size = "small",
    srcs = ["missile_test.cpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":missile_library",
        "//engine:driver",
        "@lib//base:testing",
    ],
)

cc_binary(
    name = "missile",
    srcs = ["main.cpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":missile_library",
        "//engine:driver",
    ],
)

cc_binary(
    name = "viewer",
    srcs = ["viewer.cpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":missile_library",
        "//engine:driver",
        "@imgui",
        "@imgui//backends:platform-sdl2",
        "@imgui//backends:renderer-sdl2",
        "@implot",
        "@lib//base:core",
        "@sdl2",
    ],
)

cc_binary(
    name = "missile_benchmark",
    srcs = ["missile_benchmark.cpp"],
    copts = COPTS,
    deps = [
        "//framework:vocabulary",
        ":missile_library",
        "//framework",
        "//framework:benchmark_support",
        "@lib//base:core",
    ],
)
