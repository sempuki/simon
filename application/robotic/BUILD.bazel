load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_test(
    name = "model_test",
    size = "small",
    srcs = ["model_test.cpp"],
    copts = COPTS,
    data = glob(["models/*.xml"]) + [
        "reference/mujoco_models.csv",
        "//3rd_party:menagerie",
        "//3rd_party:mujoco",
    ],
    deps = [
        ":testing",
        "//format:mjcf",
        "//model/articulated:articulated",
        "@lib//base:testing",
    ],
)

cc_library(
    name = "robotic_library",
    srcs = [
        "simulation.cpp",
        "simulation_systems.cpp",
    ],
    hdrs = [
        "simulation.hpp",
        "simulation_components.hpp",
        "simulation_systems.hpp",
    ],
    copts = COPTS,
    deps = [
        "//engine:lifecycle",
        "//format:mjcf",
        "//framework",
        "//core:vocabulary",
        "//model/articulated:articulated",
        "//model/articulated:collision",
        "//model/articulated:constraint",
        "//model/articulated:dynamics",
        "//model:kinematics",
        "//core:units",
    ],
)

cc_library(
    name = "testing",
    testonly = True,
    hdrs = ["testing.hpp"],
    copts = COPTS,
    deps = [
        ":robotic_library",
        "//application:testing",
        "//core:vocabulary",
        "@lib//base:testing",
    ],
)

# MuJoCo's local steps and the spread rounding gives its runs, which every
# test against MuJoCo's runs reads (reference/mujoco_checks.py).
CHECKS = [
    "reference/mujoco_local.csv",
    "reference/mujoco_spread.csv",
]

cc_test(
    name = "dynamics_test",
    size = "small",
    srcs = ["dynamics_test.cpp"],
    copts = COPTS,
    data = glob(["models/*.xml"]) + CHECKS + [
        "reference/mujoco_converged.csv",
        "reference/mujoco_dynamics.csv",
    ],
    deps = [
        ":testing",
        ":robotic_library",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "control_test",
    size = "small",
    srcs = ["control_test.cpp"],
    copts = COPTS,
    data = glob(["models/*.xml"]) + CHECKS + [
        "reference/mujoco_control.csv",
        "reference/mujoco_feedback.csv",
    ],
    deps = [
        ":testing",
        ":robotic_library",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "collision_test",
    size = "small",
    srcs = ["collision_test.cpp"],
    copts = COPTS,
    data = glob(["models/*.xml"]) + [
        "reference/mujoco_contacts.csv",
        "reference/mujoco_convex.csv",
    ],
    deps = [
        ":testing",
        ":robotic_library",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "constraint_test",
    size = "small",
    srcs = ["constraint_test.cpp"],
    copts = COPTS,
    data = glob(["models/*.xml"]) + CHECKS + [
        "reference/mujoco_constraints.csv",
        "reference/mujoco_solved.csv",
        "//3rd_party:mujoco",
    ],
    deps = [
        ":testing",
        ":robotic_library",
        "@lib//base:testing",
    ],
)

cc_binary(
    name = "robotic_benchmark",
    srcs = ["robotic_benchmark.cpp"],
    copts = COPTS,
    deps = [
        ":robotic_library",
        "//core:vocabulary",
    ],
)

VIEWER_DEPS = [
    ":robotic_library",
    "//application:viewing",
    "//engine:driver",
    "//core:vocabulary",
    "//model/articulated:arithmetic",
    "//3rd_party:imgui",
    "//3rd_party:implot",
    "@lib//base:core",
]

VIEWER_DATA = glob(["models/*.xml"]) + ["//3rd_party:mujoco"]

cc_binary(
    name = "viewer",
    srcs = ["viewer.cpp"],
    copts = COPTS,
    data = VIEWER_DATA,
    deps = VIEWER_DEPS,
)

cc_test(
    name = "viewer_humanoid_test",
    size = "small",
    srcs = ["viewer.cpp"],
    args = ["--frames=60"],
    copts = COPTS,
    data = VIEWER_DATA,
    env = {"SDL_VIDEODRIVER": "dummy"},
    deps = VIEWER_DEPS,
)

cc_test(
    name = "viewer_collisions_test",
    size = "small",
    srcs = ["viewer.cpp"],
    args = [
        "application/robotic/models/sliding.xml",
        "--frames=60",
    ],
    copts = COPTS,
    data = VIEWER_DATA,
    env = {"SDL_VIDEODRIVER": "dummy"},
    deps = VIEWER_DEPS,
)

cc_test(
    name = "menagerie_test",
    size = "small",
    srcs = ["menagerie_test.cpp"],
    copts = COPTS,
    data = CHECKS + [
        "reference/mujoco_menagerie.csv",
        "reference/mujoco_solved.csv",
        "//3rd_party:menagerie",
    ],
    deps = [
        ":testing",
        ":robotic_library",
        "@lib//base:testing",
    ],
)
