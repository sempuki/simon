<!-- Every primitive pair MuJoCo collides without its convex collider: two
     planes, one tilted on a body that cannot move; loose spheres, capsules,
     a cylinder and boxes; a box that cannot move; and a tree whose links
     overlap their parents, with a body welded to one. Margins, gaps,
     priorities, condims, frictions and soft parameters differ by geom. The
     cylinder touches only planes and spheres, by their contact types. -->
<mujoco model="collisions">
  <default>
    <geom contype="1" conaffinity="1"/>
    <default class="round">
      <geom contype="3" conaffinity="3"/>
    </default>
  </default>
  <worldbody>
    <geom name="floor" type="plane" size="0 0 1" class="round"/>
    <body name="ramp" pos="0.3 0 0.2" euler="0 -50 20">
      <geom name="ramp" type="plane" size="1 1 1" class="round"
            friction="0.4"/>
    </body>
    <body name="block" pos="-0.2 0.2 0.15" euler="10 20 30">
      <geom name="block" type="box" size="0.1 0.15 0.05"/>
    </body>
    <body name="ball">
      <freejoint/>
      <geom name="ball" type="sphere" size="0.1" class="round"/>
    </body>
    <body name="pebble">
      <freejoint/>
      <geom name="pebble" type="sphere" size="0.07" class="round" margin="0.01"
            gap="0.005" priority="1" condim="4" friction="0.7 0.01 0.001"
            solref="0.03 0.8" solimp="0.8 0.9 0.002 0.4 3"/>
    </body>
    <body name="pill">
      <freejoint/>
      <geom name="pill" type="capsule" size="0.05 0.15"/>
    </body>
    <body name="rod">
      <freejoint/>
      <geom name="rod" type="capsule" size="0.04 0.1" condim="6" margin="0.02"
            solref="-1000 -20"/>
    </body>
    <body name="drum">
      <freejoint/>
      <geom name="drum" type="cylinder" size="0.08 0.1" contype="2"
            conaffinity="2" condim="1"/>
    </body>
    <body name="crate">
      <freejoint/>
      <geom name="crate" type="box" size="0.1 0.08 0.06"/>
    </body>
    <body name="plank">
      <freejoint/>
      <geom name="plank" type="box" size="0.12 0.05 0.05" friction="1.2"
            priority="-1"/>
    </body>
    <body name="base">
      <freejoint/>
      <geom name="base" type="box" size="0.08 0.08 0.04"/>
      <body name="link" pos="0.08 0 0">
        <joint name="shoulder" axis="0 1 0"/>
        <geom name="link" type="capsule" fromto="0 0 0 0.2 0 0" size="0.03"/>
        <body name="cuff" pos="0.1 0 0">
          <geom name="cuff" type="box" size="0.04 0.05 0.05"/>
        </body>
        <body name="hand" pos="0.2 0 0">
          <joint name="wrist" axis="0 0 1"/>
          <geom name="hand" type="sphere" size="0.05" class="round"/>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
