<!-- A free body of three geoms off its frame, turned, spinning in the air:
     its inertia combined and found on principal axes. -->
<mujoco model="free body">
  <option gravity="0 0 0"/>
  <worldbody>
    <body name="tumbler" pos="0.1 -0.2 1.5" axisangle="1 1 0 25">
      <freejoint name="root"/>
      <geom name="slab" type="box" size="0.3 0.1 0.05" pos="0.05 0 0" euler="10 0 20"/>
      <geom name="post" type="cylinder" size="0.04 0.2" pos="-0.2 0.1 0.1" zaxis="1 0 1"/>
      <geom name="knob" type="ellipsoid" size="0.08 0.05 0.03" pos="0.25 -0.05 0.02"
            xyaxes="0 1 0 -1 0 0.3" density="3000"/>
    </body>
  </worldbody>
</mujoco>
