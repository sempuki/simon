<!-- Two capsules on hinges, one below the other: chaotic once released. -->
<mujoco model="double pendulum">
  <option timestep="0.001"/>
  <worldbody>
    <body name="upper" pos="0 0 2" euler="0 30 0">
      <joint name="shoulder" axis="0 1 0"/>
      <geom name="upper" type="capsule" fromto="0 0 0 0 0 -0.6" size="0.03" density="800"/>
      <body name="lower" pos="0 0 -0.6">
        <joint name="elbow" axis="0 1 0" pos="0 0 0"/>
        <geom name="lower" type="capsule" fromto="0 0 0 0 0 -0.5" size="0.025" mass="0.7"/>
      </body>
    </body>
  </worldbody>
</mujoco>
