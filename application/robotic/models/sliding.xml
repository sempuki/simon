<!-- A box sliding on the floor until Coulomb friction stops it, and a
     capsule lying across it, rolling, with torsional and rolling friction. -->
<mujoco model="sliding">
  <worldbody>
    <geom name="floor" type="plane" size="0 0 1" friction="0.4 0.005 0.0001"/>
    <body name="box" pos="0 0 0.1">
      <freejoint/>
      <geom name="box" type="box" size="0.1 0.1 0.1" friction="0.4"/>
    </body>
    <body name="log" pos="0 1 0.05" euler="0 90 0">
      <freejoint/>
      <geom name="log" type="capsule" size="0.05 0.2" condim="6"
            friction="0.4 0.02 0.01"/>
    </body>
  </worldbody>
</mujoco>
