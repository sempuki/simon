<!-- Joints against their limits and their dry friction: a pendulum on a
     limited hinge, one on a limited ball, a slide with a limit, a margin and
     dry friction, and a hinge with dry friction alone. -->
<mujoco model="limits">
  <worldbody>
    <body name="hinged" pos="0 0 2">
      <joint name="hinge" axis="0 1 0" range="-30 30"
             solreflimit="0.01 0.8" solimplimit="0.8 0.95 0.002"/>
      <geom type="capsule" fromto="0 0 0 0.4 0 0" size="0.03"/>
    </body>
    <body name="balled" pos="1 0 2">
      <joint name="ball" type="ball" range="0 45"/>
      <geom type="capsule" fromto="0 0 0 0.3 0 -0.2" size="0.03"/>
    </body>
    <body name="slider" pos="2 0 2">
      <joint name="slide" type="slide" axis="1 0 0.5" range="-0.2 0.1"
             margin="0.02" frictionloss="0.5"/>
      <geom type="box" size="0.05 0.05 0.05"/>
    </body>
    <body name="rubbed" pos="3 0 2">
      <joint name="rub" axis="1 0 0" frictionloss="0.05"
             solreffriction="0.03 1"/>
      <geom type="capsule" fromto="0 0 0 0 0.3 0" size="0.03"/>
    </body>
  </worldbody>
</mujoco>
