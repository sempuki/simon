VIEWER_DEPS = [
    ":automotive_library",
    ":road_drawing",
    "//application:viewing",
    "//engine:driver",
    "//model:collision",
    "//3rd_party:imgui",
    "//3rd_party:implot",
    "@lib//base:core",
]

VIEWER_DATA = glob(["roads/*.xodr"]) + [
    "//3rd_party:carla",
    "//3rd_party:esmini",
]

cc_binary(
    name = "viewer",
    srcs = ["viewer.cpp"],
    copts = COPTS,
    data = VIEWER_DATA,
    deps = VIEWER_DEPS,
)

cc_test(
    name = "viewer_signals_test",
    size = "small",
    srcs = ["viewer.cpp"],
    args = [
        "application/automotive/roads/signalized.xodr",
        "30",
        "1",
        "80",
        "--frames=60",
    ],
    copts = COPTS,
    data = VIEWER_DATA,
    env = {"SDL_VIDEODRIVER": "dummy"},
    deps = VIEWER_DEPS,
)

