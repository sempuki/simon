load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "automotive_library",
    srcs = [
        "scenario_simulation.cpp",
        "simulation.cpp",
        "simulation_systems.cpp",
    ],
    hdrs = [
        "scenario_simulation.hpp",
        "simulation.hpp",
        "simulation_components.hpp",
        "simulation_systems.hpp",
    ],
    copts = COPTS,
    deps = [
        "//engine:lifecycle",
        "//engine:rate_gate",
        "//framework",
        "//framework:vocabulary",
        "//model:kinematics",
        "//model:lane_graph",
        "//format:opendrive",
        "//format:openscenario",
        "//scenario:openscenario",
        "//model:random",
        "//model:road",
        "//model:road_placement",
        "//scenario:storyboard",
        "//model:traffic",
        "//scenario:transition",
        "//model:units",
        "@lib//base:core",
    ],
)

cc_binary(
    name = "automotive",
    srcs = ["main.cpp"],
    copts = COPTS,
    data = glob(["roads/*.xodr"]),
    deps = [
        ":automotive_library",
        "//engine:driver",
        "//framework:vocabulary",
    ],
)

cc_binary(
    name = "scenario",
    srcs = ["scenario_main.cpp"],
    copts = COPTS,
    data = glob(["scenarios/**"]),
    deps = [
        ":automotive_library",
        "//engine:driver",
        "//framework:vocabulary",
    ],
)

cc_binary(
    name = "automotive_benchmark",
    srcs = ["automotive_benchmark.cpp"],
    copts = COPTS,
    data = ["roads/rings.xodr"],
    deps = [
        ":automotive_library",
        "//framework:benchmarking",
        "//framework:vocabulary",
        "@lib//base:core",
    ],
)

cc_test(
    name = "automotive_test",
    size = "small",
    srcs = ["automotive_test.cpp"],
    copts = COPTS,
    data = glob(["roads/*.xodr"]),
    deps = [
        ":automotive_library",
        "//framework:vocabulary",
        "@lib//base:testing",
    ],
)

cc_library(
    name = "testing",
    testonly = True,
    hdrs = ["testing.hpp"],
    copts = COPTS,
    deps = [
        "//model:units",
        "//model:vehicle",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "maneuver_test",
    size = "small",
    srcs = ["maneuver_test.cpp"],
    copts = COPTS,
    data = glob([
        "reference/chrono_*.csv",
        "tires/*.tir",
    ]),
    deps = [
        ":testing",
        "//framework",
        "//model:multibody",
        "//model:single_track",
        "//format:tire_file",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "openscenario_test",
    size = "small",
    srcs = ["openscenario_test.cpp"],
    copts = COPTS,
    data = glob(["scenarios/**"]),
    deps = [
        "//format:openscenario",
        "//scenario:openscenario",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "opendrive_reference_test",
    size = "small",
    srcs = ["opendrive_reference_test.cpp"],
    copts = COPTS,
    data = glob([
        "roads/*.xodr",
        "reference/exact_positions.csv",
        "reference/libopendrive_*.csv",
    ]),
    deps = [
        ":testing",
        "//framework:vocabulary",
        "//model:lane_graph",
        "//format:opendrive",
        "//model:road",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "scenario_test",
    size = "small",
    srcs = ["scenario_test.cpp"],
    copts = COPTS,
    data = glob(["scenarios/**"]) + ["reference/esmini_scenarios.csv"],
    deps = [
        ":automotive_library",
        ":testing",
        "//framework:vocabulary",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "single_track_test",
    size = "small",
    srcs = ["single_track_test.cpp"],
    copts = COPTS,
    data = glob(["reference/commonroad_*.csv"]),
    deps = [
        ":testing",
        "//model:single_track",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "vehicle_dynamics_test",
    size = "small",
    srcs = ["vehicle_dynamics_test.cpp"],
    copts = COPTS,
    data = glob(["reference/commonroad_*.csv"]),
    deps = [
        ":testing",
        "//model:multibody",
        "//model:single_track",
        "//model:tire",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "tire_test",
    size = "small",
    srcs = ["tire_test.cpp"],
    copts = COPTS,
    data = glob([
        "reference/chrono_*.csv",
        "tires/*.tir",
    ]),
    deps = [
        ":testing",
        "//model:tire",
        "//format:tire_file",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "traffic_test",
    size = "small",
    srcs = ["traffic_test.cpp"],
    copts = COPTS,
    data = [
        "reference/movsim_idm.csv",
        "reference/movsim_mobil.csv",
        "reference/sumo_platoon.csv",
    ],
    deps = [
        ":testing",
        "//model:traffic",
        "@lib//base:testing",
    ],
)
