load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "automotive_library",
    srcs = [
        "scenario_batch.cpp",
        "scenario_simulation.cpp",
        "simulation.cpp",
        "simulation_systems.cpp",
    ],
    hdrs = [
        "scenario_batch.hpp",
        "scenario_simulation.hpp",
        "simulation.hpp",
        "simulation_components.hpp",
        "simulation_systems.hpp",
    ],
    copts = COPTS,
    deps = [
        "//engine:lifecycle",
        "//engine:rate_gate",
        "//framework",
        "//core:argument",
        "//core:math",
        "//model:kinematics",
        "//model/road:lane_graph",
        "//model/traffic:right_of_way",
        "//model/road:walking_graph",
        "//model/traffic:traffic_control",
        "//format:opendrive",
        "//format:openscenario",
        "//scenario:openscenario",
        "//scenario:parameter_distribution",
        "//model:collision",
        "//model/traffic:driving_metrics",
        "//core:random",
        "//model/road:road",
        "//model/road:polyline",
        "//model/road:road_placement",
        "//scenario:storyboard",
        "//model/traffic:traffic",
        "//scenario:transition",
        "//core:units",
        "@lib//base:core",
    ],
)

cc_binary(
    name = "automotive",
    srcs = ["main.cpp"],
    copts = COPTS,
    data = glob(["roads/*.xodr"]) + ["//3rd_party:carla"],
    deps = [
        ":automotive_library",
        "//engine:driver",
        "//core:argument",
    ],
)

cc_binary(
    name = "scenario",
    srcs = ["scenario_main.cpp"],
    copts = COPTS,
    data = ["//3rd_party:esmini"],
    deps = [
        ":automotive_library",
        "//engine:driver",
        "//core:argument",
        "//core:math",
    ],
)

cc_library(
    name = "road_drawing",
    srcs = ["road_drawing.cpp"],
    hdrs = ["road_drawing.hpp"],
    copts = COPTS,
    deps = [
        "//model:collision",
        "//model/road:road",
