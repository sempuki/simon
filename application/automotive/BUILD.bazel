load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "automotive_library",
    srcs = ["simulation.cpp"],
    hdrs = [
        "simulation.hpp",
        "simulation_components.hpp",
        "simulation_systems.hpp",
    ],
    copts = COPTS,
    deps = [
        "//engine:lifecycle",
        "//engine:rate_gate",
        "//framework",
        "//framework:vocabulary",
        "//model:kinematics",
        "//model:lane_graph",
        "//model:opendrive",
        "//model:random",
        "//model:road",
        "//model:traffic",
        "//model:units",
        "@lib//base:core",
    ],
)

cc_binary(
    name = "automotive",
    srcs = ["main.cpp"],
    copts = COPTS,
    data = glob(["roads/*.xodr"]),
    deps = [
        ":automotive_library",
        "//engine:driver",
        "//framework:vocabulary",
    ],
)

cc_test(
    name = "automotive_test",
    size = "small",
    srcs = ["automotive_test.cpp"],
    copts = COPTS,
    data = glob(["roads/*.xodr"]),
    deps = [
        ":automotive_library",
        "//framework:vocabulary",
        "@lib//base:testing",
    ],
)

cc_library(
    name = "testing",
    testonly = True,
    hdrs = ["testing.hpp"],
    copts = COPTS,
    deps = ["@lib//base:testing"],
)

cc_test(
    name = "opendrive_reference_test",
    size = "small",
    srcs = ["opendrive_reference_test.cpp"],
    copts = COPTS,
    data = glob([
        "roads/*.xodr",
        "reference/exact_positions.csv",
        "reference/libopendrive_*.csv",
    ]),
    deps = [
        ":testing",
        "//framework:vocabulary",
        "//model:lane_graph",
        "//model:opendrive",
        "//model:road",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "single_track_test",
    size = "small",
    srcs = ["single_track_test.cpp"],
    copts = COPTS,
    data = glob(["reference/commonroad_*.csv"]),
    deps = [
        ":testing",
        "//model:single_track",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "traffic_test",
    size = "small",
    srcs = ["traffic_test.cpp"],
    copts = COPTS,
    data = [
        "reference/movsim_idm.csv",
        "reference/movsim_mobil.csv",
        "reference/sumo_platoon.csv",
    ],
    deps = [
        ":testing",
        "//model:traffic",
        "@lib//base:testing",
    ],
)
