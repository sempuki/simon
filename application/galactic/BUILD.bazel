load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "galactic_library",
    srcs = ["simulation.cpp"],
    hdrs = [
        "simulation.hpp",
        "simulation_components.hpp",
        "simulation_systems.hpp",
    ],
    copts = COPTS,
    deps = [
        "//engine:driver",
        "//engine:lifecycle",
        "//framework",
        "//framework:vocabulary",
        "//model:galaxy",
        "//model:gravity",
        "//model:kinematics",
        "//model:leapfrog",
        "//model:units",
    ],
)

cc_test(
    name = "gravity_test",
    size = "small",
    srcs = ["gravity_test.cpp"],
    copts = COPTS,
    data = [
        "reference/rebound_forces.csv",
        "reference/rebound_leapfrog.csv",
    ],
    deps = [
        ":galactic_library",
        "//application:testing",
        "//engine:driver",
        "//framework:vocabulary",
        "//model:gravity",
        "@lib//base:testing",
    ],
)

cc_test(
    name = "plummer_test",
    size = "small",
    srcs = ["plummer_test.cpp"],
    copts = COPTS,
    deps = [
        ":galactic_library",
        "//engine:driver",
        "//framework:vocabulary",
        "//model:galaxy",
        "//model:gravity",
        "//model:random",
        "@lib//base:testing",
    ],
)
