load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "argument",
    hdrs = ["argument.hpp"],
    copts = COPTS,
    deps = ["@lib//base:core"],
)

cc_library(
    name = "math",
    hdrs = ["math.hpp"],
    copts = COPTS,
    deps = ["//3rd_party:eigen"],
)

cc_library(
    name = "time",
    hdrs = ["time.hpp"],
    copts = COPTS,
)

cc_library(
    name = "coordinates",
    hdrs = ["coordinates.hpp"],
    copts = COPTS,
)

cc_library(
    name = "units",
    hdrs = ["units.hpp"],
    copts = COPTS,
    deps = [
        ":math",
        "//3rd_party:eigen",
        "//3rd_party:mp-units",
    ],
)

cc_library(
    name = "text",
    srcs = ["text.cpp"],
    hdrs = ["text.hpp"],
    copts = COPTS,
)

cc_library(
    name = "random",
    hdrs = ["random.hpp"],
    copts = COPTS,
)

cc_library(
    name = "lie",
    hdrs = ["lie.hpp"],
    copts = COPTS,
    deps = [
        ":math",
        "//3rd_party:eigen",
    ],
)

[cc_test(
    name = test + "_test",
    size = "small",
    srcs = [test + "_test.cpp"],
    copts = COPTS,
    deps = [
        ":" + test,
        "@lib//base:testing",
    ],
) for test in [
    "lie",
    "random",
    "text",
    "time",
    "units",
]]
