module(
    name = "simon",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(name = "rules_cc", version = "0.2.25")

# Third-party libraries, depended on through //3rd_party (see 3rd_party/README.md).
bazel_dep(name = "catch2", version = "3.15.1")
bazel_dep(name = "eigen", version = "5.0.1.bcr.2")
bazel_dep(name = "mp-units", version = "2.5.0.bcr.0")
bazel_dep(name = "pugixml", version = "1.15")
bazel_dep(name = "imgui", version = "1.92.6-docking.bcr.1")
bazel_dep(name = "implot", version = "0.17")
bazel_dep(name = "sdl2", version = "2.32.0.bcr.beta.6")

# Shared core libraries, vendored as a git submodule.
bazel_dep(name = "lib")
local_path_override(
    module_name = "lib",
    path = "2nd_party/lib",
)
