load("@lib//bazel:copts.bzl", "COPTS")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "lifecycle",
    hdrs = ["lifecycle.hpp"],
    copts = COPTS,
    deps = [
        "//framework",
        "@lib//base:status",
    ],
)

cc_library(
    name = "driver",
    hdrs = ["driver.hpp"],
    copts = COPTS,
    deps = [
        ":lifecycle",
        "//framework",
        "@lib//base:core",
    ],
)

cc_library(
    name = "rate_gate",
    hdrs = ["rate_gate.hpp"],
    copts = COPTS,
    deps = [
        "//framework",
        "@lib//base:core",
    ],
)

cc_library(
    name = "event_queue",
    hdrs = ["event_queue.hpp"],
    copts = COPTS,
    deps = ["//framework"],
)

[cc_test(
    name = test + "_test",
    size = "small",
    srcs = [test + "_test.cpp"],
    copts = COPTS,
    deps = [
        ":" + test,
        "@lib//base:testing",
    ],
) for test in [
    "driver",
    "event_queue",
    "rate_gate",
]]
